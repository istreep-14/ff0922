# FantasyPros account email — this alone enumerates every league + per-league key
FP_EMAIL=istreeper14@gmail.com

# Optional: extra league keys not tied to the email above (comma separated)
# FP_EXTRA_KEYS=nfl~7cd9fb32-a82d-434f-9ce7-3fe8edbf9f5f

# FantasyPros public API v2 key — request at https://secure.fantasypros.com/api-keys/request/
# This is a DIFFERENT credential from the MyPlaybook league keys above.
FP_API_KEY=o8m8eCpV0Z9cpbVErBlBF4KmwUzeZTx99M0Ojr7q

# Optional: pin season/week. Both are auto-detected from the calendar when unset.
# FP_SEASON=2026
# FP_WEEK=1

# VegasEdgeFantasy session cookie — copy the `access_token` cookie value from a
# logged-in browser session. It is a JWT and expires (~30 days).
VEGAS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxNTIiLCJlbWFpbCI6ImJzdHJlZXBlcjNAZ21haWwuY29tIiwiZXBvY2giOjAsImV4cCI6MTc5MTc0NDI5Mn0.h17_EqYvHqobC8WUoF_-c-Rl-hV9BazGjV7txC3u7hg

# Yahoo Fantasy session cookie — the FULL `Cookie:` header value from a
# logged-in football.fantasysports.yahoo.com request (DevTools > Network >
# any request to that host > Request Headers > Cookie). Not a single token;
# Yahoo's session is spread across ~10-15 cookies (A1, A3, B, cmp, GUC, ...).
# YAHOO_COOKIE=

# League used for weekly Yahoo projections (scored under that league's own
# settings). Defaults to 529792 if unset.
# YAHOO_LEAGUE_ID=529792

# Pacing for Yahoo requests specifically — kept separate from
# FP_CONCURRENCY/FP_DELAY_MS because Yahoo's edge bot-mitigation returns
# HTTP 999 ("Request denied") to a burst that looks automated. Defaults are
# already conservative (1 request at a time, 2s apart); raise the delay
# further if you still see 999s.
# YAHOO_CONCURRENCY=1
# YAHOO_DELAY_MS=2000

# Optional tuning
FP_CONCURRENCY=3
FP_DELAY_MS=250


# Per-request deadline in ms. 0 disables it. Default 30000.
FP_TIMEOUT_MS=30000

# Minimum gap in ms between FantasyPros API v2 calls (burst rate limit).
# Default 1200. Raise it if you see 429s on fp:sync.
FP_API_GAP_MS=1200
