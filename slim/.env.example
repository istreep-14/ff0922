# FantasyPros account email. This alone lists every league on the account.
FP_EMAIL=

# Optional league keys not on that email, comma separated.
# FP_EXTRA_KEYS=

# Optional. Both are inferred from the calendar when unset.
# FP_SEASON=2026
# FP_WEEK=3

# Optional pacing.
# FP_CONCURRENCY=3
# FP_DELAY_MS=250
# FP_TIMEOUT_MS=30000
